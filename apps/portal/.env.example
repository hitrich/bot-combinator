# Public client configuration. The publishable key is safe in the browser only
# because every exposed table and storage object is protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PORTAL_URL=https://portal.example.com

# Local development only. Never enable this on a production deployment.
VITE_PORTAL_DEMO_MODE=false
