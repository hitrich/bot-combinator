# Public client configuration. The publishable key is safe in the browser only
# because every exposed table and storage object is protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PORTAL_URL=https://portal.example.com

# Local development only. Never enable this on a production deployment.
VITE_PORTAL_DEMO_MODE=false

# Desktop distribution. Use the final HTTPS file URL for each verified native
# package. The portal never redirects project users to a source-code host.
VITE_DESKTOP_VERSION=v0.1.2
VITE_DESKTOP_MACOS_ARM64_URL=https://downloads.example.com/Bot-Combinator-macos-arm64.dmg
VITE_DESKTOP_MACOS_X64_URL=https://downloads.example.com/Bot-Combinator-macos-x64.dmg
VITE_DESKTOP_WINDOWS_X64_URL=https://downloads.example.com/Bot-Combinator-windows-x64.exe
VITE_DESKTOP_WINDOWS_ARM64_URL=https://downloads.example.com/Bot-Combinator-windows-arm64.exe
VITE_DESKTOP_LINUX_X64_URL=https://downloads.example.com/Bot-Combinator-linux-x64.AppImage
VITE_DESKTOP_LINUX_ARM64_URL=https://downloads.example.com/Bot-Combinator-linux-arm64.AppImage
