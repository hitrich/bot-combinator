{
  "name": "bot-combinator",
  "version": "0.1.2",
  "private": true,
  "description": "A local-first, evidence-backed fundraising operating system for founders.",
  "author": "Bot Combinator contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hitrich/bot-combinator.git"
  },
  "homepage": "https://github.com/hitrich/bot-combinator#readme",
  "bugs": {
    "url": "https://github.com/hitrich/bot-combinator/issues"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "pnpm build:packages",
    "dev": "pnpm --filter @bot-combinator/desktop dev",
    "dev:portal": "pnpm --filter @bot-combinator/portal dev",
    "build:portal": "pnpm --filter @bot-combinator/portal build",
    "test:portal": "pnpm --filter @bot-combinator/portal test",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm -r --filter @bot-combinator/agents --filter @bot-combinator/connectors --filter @bot-combinator/core --filter @bot-combinator/mcp --if-present build",
    "prelint": "pnpm build:packages",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --if-present test",
    "pretest:unit": "pnpm build:packages",
    "test:unit": "pnpm -r --if-present test:unit",
    "pretest:integration": "pnpm build:packages",
    "test:integration": "pnpm -r --if-present test:integration",
    "pretest:coverage": "pnpm build:packages",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "pretest:e2e": "pnpm build:packages",
    "test:e2e": "pnpm --filter @bot-combinator/desktop test:e2e",
    "pretest:e2e:headed": "pnpm build:packages",
    "test:e2e:headed": "pnpm --filter @bot-combinator/desktop test:e2e:headed",
    "presmoke:codex": "pnpm build:packages",
    "smoke:codex": "pnpm prepare:live-agents && pnpm --filter @bot-combinator/desktop build && pnpm --filter @bot-combinator/desktop exec node scripts/smoke-codex-subscription.mjs",
    "smoke:claude": "pnpm build:packages && node scripts/smoke-claude-subscription.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare:runtime": "node scripts/prepare-runtime-resources.mjs",
    "prepare:live-agents": "node scripts/prepare-live-agent-resources.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "package": "pnpm prepare:resources && pnpm --filter @bot-combinator/desktop package",
    "package:mac": "pnpm prepare:resources && pnpm --filter @bot-combinator/desktop package:mac",
    "package:win": "pnpm prepare:resources && pnpm --filter @bot-combinator/desktop package:win",
    "package:linux": "pnpm prepare:resources && pnpm --filter @bot-combinator/desktop package:linux",
    "release:mac:local": "node scripts/package-signed-target.mjs --local-keychain --platform darwin",
    "release:verify": "node scripts/verify-release.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
